# Copy this file to .env.local for local development and fill in real values.
# .env.local is gitignored; this file holds placeholders only. In production,
# set these as Vercel Environment Variables, never in a committed file.
# The marketing pages need none of them. They are for POST /api/chat (Ask
# PureScan, contract in docs/chat-api.md) and the label photo-fill routes
# (/api/label and /api/attest, contract in docs/label-api.md).

# Gemini API key (Google AI Studio). Required: without it Ask PureScan stays switched off.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (default gemini-3.5-flash-lite, the fastest and cheapest).
GEMINI_MODEL=gemini-3.5-flash-lite

# Kill switch. Leave unset (or "true") to run chat when GEMINI_API_KEY is
# set; "false" turns it off immediately (every request gets 503 unavailable).
CHAT_ENABLED=true

# Most questions answered per UTC day across all users (default 3000).
CHAT_GLOBAL_DAILY_LIMIT=3000

# Upstash Redis (REST) for rate limits shared across serverless instances.
# Optional for chat: when unset, limits are counted in memory per instance.
# Required for label photo-fill in production (readings, App Attest keys and
# challenges live here); without it, label routes answer 503 in production and
# use process memory in local development.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Secret for the keyed hash (HMAC-SHA256) of transaction IDs, device ids and
# IPs in rate-limit keys and stored label readings (shared by chat and labels). Required when Upstash is set; generate one with
#   openssl rand -hex 32
# Without Upstash, a random per-process secret is used if this is unset.
CHAT_HASH_SECRET=your_random_hex_secret_here

# --- Label photo-fill (docs/label-api.md) ---

# Gemini API key for reading label photos. Use a SEPARATE Google project from
# GEMINI_API_KEY, with prepaid billing and auto-reload OFF, so spend can never
# exceed what's loaded. Required: without it photo reads stay switched off.
GEMINI_LABEL_API_KEY=your_label_gemini_api_key_here

# Optional model override (default: the same model as chat, gemini-3.5-flash-lite).
GEMINI_LABEL_MODEL=gemini-3.5-flash-lite

# Kill switch for photo reads. Leave unset (or "true") to run them when the key
# is set; "false" stops them immediately (503). Saved readings are still served.
LABEL_ENABLED=true

# Most photo reads per UTC day across all users (default 500).
LABEL_GLOBAL_DAILY_LIMIT=500

# Local testing only: "false" lets the iOS Simulator (which can't use App
# Attest) send unattested requests, keyed by IP. Ignored in production, where
# App Attest is always required.
LABEL_REQUIRE_APP_ATTEST=true

# "true" also accepts App Attest keys from development (Xcode-signed) builds.
APP_ATTEST_ALLOW_DEVELOPMENT=false

# Give label photos to Open Food Facts when the user opts in (photos only,
# never the AI reading). Needs all three; create a dedicated OFF account for
# the app and keep its password secret.
OFF_CONTRIBUTION_ENABLED=false
OFF_USER_ID=your_open_food_facts_user_id
OFF_PASSWORD=your_open_food_facts_password
