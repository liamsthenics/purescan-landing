# Copy this file to .env.local for local development and fill in real values.
# .env.local is gitignored; this file holds placeholders only. In production,
# set these as Vercel Environment Variables, never in a committed file.
# The marketing pages need none of them; they are all for POST /api/chat
# (Ask PureScan, contract in docs/chat-api.md).

# Gemini API key (Google AI Studio). Required: without it Ask PureScan stays switched off.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (default gemini-3.5-flash-lite, the fastest and cheapest).
GEMINI_MODEL=gemini-3.5-flash-lite

# Kill switch. Leave unset (or "true") to run chat when GEMINI_API_KEY is
# set; "false" turns it off immediately (every request gets 503 unavailable).
CHAT_ENABLED=true

# Most questions answered per UTC day across all users (default 3000).
CHAT_GLOBAL_DAILY_LIMIT=3000

# Upstash Redis (REST) for rate limits shared across serverless instances.
# Optional: when unset, limits are counted in memory per instance.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Secret for the keyed hash (HMAC-SHA256) of transaction IDs and IPs in
# rate-limit keys. Required when Upstash is set; generate one with
#   openssl rand -hex 32
# Without Upstash, a random per-process secret is used if this is unset.
CHAT_HASH_SECRET=your_random_hex_secret_here
